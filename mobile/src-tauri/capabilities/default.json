{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "What the phone UI may use",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:app:default",
    "core:app:allow-app-show",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
